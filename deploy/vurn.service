# ── VurnChat P2P Node — systemd service ──────────────────────────────
# Source: https://github.com/vurnchat/vurn-server
#
# Installed by: install.sh
#
# Architecture:
#   vurn-server runs in plain WS mode on VURN_PORT
#   socat (optional) handles TLS on SOCAT_PORT, forwards to :VURN_PORT
#   This bypasses VPN/MTU issues with direct TLS connections.
#
# Data directory: /var/lib/vurn/
#   ├── vurn_mailbox_<PORT>.db  (Sled DB — mailbox backup)
#   └── peers/                  (persisted peer addresses)
#
# Config: /etc/vurn/vurn.env
#
# Logs: journalctl -u vurn.service -f
# Socat logs: journalctl -u vurn-socat.service -f

[Unit]
Description=VurnChat — Post-Quantum Encrypted P2P Messenger Node
Documentation=https://github.com/vurnchat/vurn-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

User=vurn
Group=vurn

WorkingDirectory=/var/lib/vurn
StateDirectory=vurn
StateDirectoryMode=0750

EnvironmentFile=-/etc/vurn/vurn.env

ExecStart=/usr/local/bin/vurn-server

Restart=always
RestartSec=5
RestartMaxDelaySec=30

MemoryMax=512M
IOWriteBandwidthMax=/var/lib/vurn 10M

CapabilityBoundingSet=
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
PrivateDevices=true
DevicePolicy=closed
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service

LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
