# ── VurnChat P2P Node — systemd service ──────────────────────────────
# Source: https://github.com/scramble22/VurnChat
#
# Installed by: install.sh
# Manually: sudo cp deploy/vurn.service /etc/systemd/system/vurn.service
#           sudo systemctl daemon-reload && sudo systemctl enable --now vurn
#
# Data directory: /var/lib/vurn/
#   ├── vurn_mailbox_<PORT>.db  (Sled DB — mailbox backup)
#   └── peers/                  (persisted peer addresses)
#
# Config: /etc/vurn/vurn.env
#
# Logs: journalctl -u vurn.service -f

[Unit]
Description=VurnChat — Post-Quantum Encrypted P2P Messenger Node
Documentation=https://github.com/scramble22/VurnChat
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# ── User ─────────────────────────────────────────────────────────────
# Runs as a dedicated system user with no login shell.
# Created by install.sh or manually:
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin vurn
User=vurn
Group=vurn

# ── Working directory & state ───────────────────────────────────────
WorkingDirectory=/var/lib/vurn
StateDirectory=vurn
StateDirectoryMode=0750

# ── Environment ──────────────────────────────────────────────────────
# Load config from /etc/vurn/vurn.env (created by install.sh)
EnvironmentFile=-/etc/vurn/vurn.env
Environment=RUST_LOG=${VURN_LOG:-info}

# ── Startup command ─────────────────────────────────────────────────
# Reads configuration from environment variables (set in vurn.env).
# Falls back to sensible defaults if env vars are unset.
ExecStart=/usr/local/bin/vurn-server \
    --port ${VURN_PORT:-9000} \
    --listen-p2p ${VURN_P2P_LISTEN:-/ip4/0.0.0.0/tcp/0} \
    ${VURN_BOOTSTRAP:+--bootstrap $VURN_BOOTSTRAP} \
    ${VURN_CERT:+--cert $VURN_CERT} \
    ${VURN_KEY:+--key $VURN_KEY}

# ── Restart policy ──────────────────────────────────────────────────
Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=10

# ── Resource limits ─────────────────────────────────────────────────
# 512 MB max RSS (adjust for your workload)
MemoryMax=512M
# 10 GB disk write limit per second (prevents Sled from flooding disk)
IOWriteBandwidthMax=/var/lib/vurn 10M

# ── Security hardening ──────────────────────────────────────────────
CapabilityBoundingSet=
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
PrivateDevices=true
DevicePolicy=closed
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service

# ── File descriptor limit ───────────────────────────────────────────
# libp2p + WebSocket connections: 1024 should be plenty for a relay node.
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
