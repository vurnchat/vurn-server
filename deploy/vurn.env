# ── VurnChat Server — Environment Configuration ────────────────────
# Source: https://github.com/vurnchat/vurn-server
#
# Copy this file to /etc/vurn/vurn.env and edit to match your setup.
# This file is read by the vurn.service systemd unit (EnvironmentFile).
#
# Usage:
#   sudo cp deploy/vurn.env /etc/vurn/vurn.env
#   sudo chmod 600 /etc/vurn/vurn.env
#   sudo systemctl daemon-reload && sudo systemctl restart vurn

# ── Required ────────────────────────────────────────────────────────

# WebSocket/TLS gateway port (default: 9000)
VURN_PORT=9000

# ── P2P Network (optional) ──────────────────────────────────────────

# P2P listen address (default: /ip4/0.0.0.0/tcp/0 = random port)
# Set a fixed port for stable multiaddr (e.g., for bootstrap nodes):
VURN_P2P_LISTEN="/ip4/0.0.0.0/tcp/9001"

# Bootstrap peers (space-separated multiaddrs)
# VURN_BOOTSTRAP="/ip4/1.2.3.4/tcp/9001 /ip4/5.6.7.8/tcp/9001"

# ── TLS / WSS (optional — omit for plain WS) ───────────────────────

# Path to TLS certificate (PEM format)
# VURN_CERT="/etc/letsencrypt/live/example.com/fullchain.pem"

# Path to TLS private key (PEM format)
# VURN_KEY="/etc/letsencrypt/live/example.com/privkey.pem"

# ── Logging ─────────────────────────────────────────────────────────

# Log level (default: info)
# RUST_LOG="info"

# Log format (default: plain)
# RUST_LOG_FORMAT="json"   # structured JSON logging
